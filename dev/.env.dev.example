# dev/.env.dev — local dev secrets for `npm run dev:seed`. COPY this to dev/.env.dev and fill it in.
# dev/.env.dev is gitignored; this .example is the committed template. Real shell env vars override these.

# Your OpenRouter API key (https://openrouter.ai/keys). The sidecar holds it server-side (the credential store) —
# it is never injected into the page or stored in the browser. Leave blank if you sign in with ChatGPT/Codex.
SKYNET_OPENROUTER_KEY=

# The model the seeded agent runs on. Use a model id your key can reach (OpenRouter slug).
# WARNING: model ids ROT. OpenRouter retires slugs without notice — a stale id 404s
# ("No endpoints found") and the seed's FIRST run fails. If seed.js prints the "default
# model not in live catalog" banner, the id below is dead: fetch the current list at
# https://openrouter.ai/api/v1/models and pick a live one. Verified live 2026-07-06.
# Examples (live 2026-07-06): anthropic/claude-haiku-4.5 · anthropic/claude-sonnet-4.5 · openai/gpt-4o-mini
SKYNET_DEFAULT_MODEL=anthropic/claude-haiku-4.5

# Optional: port to serve on (default 8787). Handy when running several worktrees at once.
# SKYNET_PORT=8787
