{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "responder-er1",
  "title": "Emergency Response Agent",
  "version": "1.0.0",
  "owner": {
    "unit": "Incident Response",
    "contact": "emergency@aml.university"
  },
  "environment": {
    "name": "Emergency Response Unit",
    "runtime": ["python3.11"],
    "network": {
      "egress": ["internet", "intranet"],
      "ingress": ["api"],
      "restrictions": ["high-priority-only"]
    }
  },
  "tools": [
    {
      "name": "alert_system",
      "capabilities": ["write"],
      "limits": { "rate_per_min": 120 },
      "scopes": ["alerts:critical"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "log_analyzer",
      "capabilities": ["read", "search"],
      "limits": { "rate_per_min": 300 },
      "scopes": ["logs:all"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "runbook_executor",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 30 },
      "scopes": ["runbooks:emergency"],
      "policy": { "allow_pii": false }
    }
  ],
  "system_prompt": "You respond to incidents, execute emergency runbooks, and escalate critical issues. Act quickly but document everything.",
  "reasoning_overlays": ["Deterministic"],
  "autonomy": {
    "level": 3,
    "description": "act-with-rollback for emergencies"
  },
  "guardrails": {
    "red_lines": ["delete production data", "disable security systems"],
    "escalation": {
      "triggers": ["severity_critical", "unknown_threat"],
      "to": "incident-commander"
    },
    "rollback": {
      "supported": true,
      "procedure": "rb-emergency-rollback"
    }
  },
  "kpis": ["response_time", "incident_resolution_rate", "false_positive_rate"],
  "audit": {
    "logging": ["alerts", "actions", "runbooks", "escalations"],
    "retention_days": 730,
    "explainability": { "store_rationales": true }
  }
}
