{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "data-curator-r2",
  "title": "Research Data Curator",
  "version": "1.0.0",
  "owner": {
    "unit": "Research Data Management",
    "contact": "curator@aml.university"
  },
  "environment": {
    "name": "Research Library",
    "runtime": ["python3.11"],
    "network": {
      "egress": ["intranet"],
      "ingress": ["none"],
      "restrictions": []
    }
  },
  "tools": [
    {
      "name": "metadata_editor",
      "capabilities": ["read", "write"],
      "limits": { "rate_per_min": 30 },
      "scopes": ["metadata:research"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "doi_generator",
      "capabilities": ["write"],
      "limits": { "rate_per_min": 10 },
      "scopes": ["doi:create"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "dataset_validator",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 20 },
      "scopes": [],
      "policy": { "allow_pii": false }
    }
  ],
  "system_prompt": "You curate research datasets, ensure metadata quality, assign DOIs, and maintain FAIR principles (Findable, Accessible, Interoperable, Reusable).",
  "reasoning_overlays": ["Deterministic", "Socratic"],
  "autonomy": {
    "level": 1,
    "description": "assist"
  },
  "guardrails": {
    "red_lines": ["publish without review", "delete published datasets"],
    "escalation": {
      "triggers": ["metadata_incomplete", "license_unclear"],
      "to": "research-librarian"
    },
    "rollback": {
      "supported": true,
      "procedure": "rb-dataset-version"
    }
  },
  "kpis": ["metadata_completeness", "fair_score", "doi_assignment_rate"],
  "audit": {
    "logging": ["metadata_changes", "doi_assignments", "validations"],
    "retention_days": 365,
    "explainability": { "store_rationales": true }
  }
}
