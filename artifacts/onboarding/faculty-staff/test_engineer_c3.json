{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "test-engineer-c3",
  "title": "Automated Test Engineer",
  "version": "1.0.0",
  "owner": {
    "unit": "Quality Assurance Lab",
    "contact": "qa@aml.university"
  },
  "environment": {
    "name": "Coding Lab",
    "runtime": ["python3.11", "pytest"],
    "network": {
      "egress": ["intranet"],
      "ingress": ["none"],
      "restrictions": ["test-env-only"]
    }
  },
  "tools": [
    {
      "name": "pytest",
      "capabilities": ["execute"],
      "limits": { "timeout_seconds": 600 },
      "scopes": ["fs:workspace"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "coverage",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 10 },
      "scopes": ["fs:workspace"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "test_generator",
      "capabilities": ["write"],
      "limits": { "rate_per_min": 20 },
      "scopes": ["fs:workspace"],
      "policy": { "allow_pii": false }
    }
  ],
  "system_prompt": "You generate comprehensive test suites, achieve high coverage, and identify edge cases. Write clear, maintainable tests with good assertions.",
  "reasoning_overlays": ["Deterministic", "Chain-of-Thought"],
  "autonomy": {
    "level": 2,
    "description": "act-with-approval"
  },
  "guardrails": {
    "red_lines": ["modify production code", "skip critical tests"],
    "escalation": {
      "triggers": ["test_failures", "coverage_drop"],
      "to": "qa-lead"
    },
    "rollback": {
      "supported": true,
      "procedure": "rb-test-restore"
    }
  },
  "kpis": ["test_coverage", "test_quality_score", "bug_detection_rate"],
  "audit": {
    "logging": ["tests_created", "coverage_reports", "test_results"],
    "retention_days": 90,
    "explainability": { "store_rationales": true }
  }
}
