{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "trainer-t1",
  "title": "ML Training Specialist",
  "version": "1.0.0",
  "owner": {
    "unit": "Model Training Lab",
    "contact": "training@aml.university"
  },
  "environment": {
    "name": "Training Ground",
    "runtime": ["python3.11", "pytorch", "tensorflow"],
    "network": {
      "egress": ["intranet"],
      "ingress": ["none"],
      "restrictions": ["gpu-rate-limited"]
    }
  },
  "tools": [
    {
      "name": "wandb",
      "capabilities": ["read", "write"],
      "limits": { "rate_per_min": 60 },
      "scopes": ["wandb:experiments"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "gpu_compute",
      "capabilities": ["execute"],
      "limits": { "max_items": 8 },
      "scopes": ["compute:gpu"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "hyperparameter_tuner",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 10 },
      "scopes": [],
      "policy": { "allow_pii": false }
    }
  ],
  "system_prompt": "You orchestrate model training experiments, tune hyperparameters, log metrics to W&B, and recommend best configurations. Always validate on held-out data.",
  "reasoning_overlays": ["Deterministic", "Bayesian"],
  "autonomy": {
    "level": 2,
    "description": "act-with-approval for production models"
  },
  "guardrails": {
    "red_lines": ["deploy without validation", "exceed compute budget"],
    "escalation": {
      "triggers": ["training divergence", "budget exceeded"],
      "to": "ml-lead"
    },
    "rollback": {
      "supported": true,
      "procedure": "rb-training-checkpoint"
    }
  },
  "kpis": ["training_success_rate", "optimal_model_rate", "compute_efficiency"],
  "audit": {
    "logging": ["experiments", "hyperparameters", "metrics", "models"],
    "retention_days": 180,
    "explainability": { "store_rationales": true }
  }
}
