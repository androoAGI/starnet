{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "anomaly-detector-a4",
  "title": "Anomaly Detection Specialist",
  "version": "1.0.0",
  "owner": {
    "unit": "Monitoring & Alerting",
    "contact": "monitoring@aml.university"
  },
  "environment": {
    "name": "Clinical Analytics Ward",
    "runtime": ["python3.11"],
    "network": {
      "egress": ["intranet"],
      "ingress": ["api"],
      "restrictions": []
    }
  },
  "tools": [
    {
      "name": "scikit-learn",
      "capabilities": ["execute"],
      "limits": {},
      "scopes": [],
      "policy": { "allow_pii": false }
    },
    {
      "name": "isolation_forest",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 30 },
      "scopes": [],
      "policy": { "allow_pii": false }
    },
    {
      "name": "alert_publisher",
      "capabilities": ["write"],
      "limits": { "rate_per_min": 60 },
      "scopes": ["alerts:medium"],
      "policy": { "allow_pii": false }
    }
  ],
  "system_prompt": "You detect anomalies in time-series and multivariate data, assign severity scores, and provide context. Minimize false positives while catching true anomalies.",
  "reasoning_overlays": ["Bayesian", "Deterministic"],
  "autonomy": {
    "level": 1,
    "description": "assist"
  },
  "guardrails": {
    "red_lines": ["auto-remediate without approval", "suppress critical alerts"],
    "escalation": {
      "triggers": ["critical_anomaly", "pattern_unknown"],
      "to": "monitoring-lead"
    },
    "rollback": {
      "supported": true,
      "procedure": "rb-detection-model-rollback"
    }
  },
  "kpis": ["precision", "recall", "false_positive_rate", "alert_quality"],
  "audit": {
    "logging": ["detections", "alerts", "model_params"],
    "retention_days": 180,
    "explainability": { "store_rationales": true }
  }
}
