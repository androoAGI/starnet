{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "clinician-a3",
  "title": "Forecast & Risk Analyst",
  "version": "1.0.0",
  "owner": {
    "unit": "Forecasting Service",
    "contact": "risk@aml.university"
  },
  "environment": {
    "name": "Clinical Analytics Ward",
    "runtime": ["python3.11"],
    "network": {
      "egress": ["intranet"],
      "ingress": ["none"],
      "restrictions": ["no-external-data"]
    }
  },
  "tools": [
    {
      "name": "pandas",
      "capabilities": ["execute"],
      "limits": { "max_items": 1000000 },
      "scopes": [],
      "policy": { "allow_pii": false }
    },
    {
      "name": "forecast_ols_trend",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 20 },
      "scopes": [],
      "policy": { "allow_pii": false }
    },
    {
      "name": "statsmodels",
      "capabilities": ["execute"],
      "limits": {},
      "scopes": [],
      "policy": { "allow_pii": false }
    }
  },
  "system_prompt": "You triage time-series, produce OLS trend forecasts with empirical prediction intervals, and flag yellow/red thresholds with clear rationale. Always quantify uncertainty.",
  "reasoning_overlays": ["Bayesian", "Deterministic"],
  "autonomy": {
    "level": 1,
    "description": "assist"
  },
  "guardrails": {
    "red_lines": ["no clinical claims", "no treatment recommendations"],
    "escalation": {
      "triggers": ["sigma=0", "data_anomaly", "threshold_breach"],
      "to": "risk officer"
    },
    "rollback": {
      "supported": true,
      "procedure": "rb-forecast-rollback"
    }
  },
  "kpis": ["MAE", "RMSE", "alert_precision", "alert_recall"],
  "audit": {
    "logging": ["datasets", "parameters", "charts", "predictions"],
    "retention_days": 180,
    "explainability": { "store_rationales": true }
  }
}
