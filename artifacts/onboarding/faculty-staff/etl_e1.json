{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "etl-e1",
  "title": "ETL Pipeline Engineer",
  "version": "1.0.0",
  "owner": {
    "unit": "Data Engineering",
    "contact": "data-eng@aml.university"
  },
  "environment": {
    "name": "Data Engineering Bay",
    "runtime": ["python3.11", "spark"],
    "network": {
      "egress": ["intranet"],
      "ingress": ["none"],
      "restrictions": ["data-catalog-only"]
    }
  },
  "tools": [
    {
      "name": "sql_executor",
      "capabilities": ["read", "write"],
      "limits": { "rate_per_min": 30 },
      "scopes": ["db:warehouse"],
      "policy": { "allow_pii": true, "export_controls": ["GDPR", "CCPA"] }
    },
    {
      "name": "spark",
      "capabilities": ["execute"],
      "limits": { "timeout_seconds": 3600 },
      "scopes": ["compute:spark"],
      "policy": { "allow_pii": true, "export_controls": ["GDPR", "CCPA"] }
    },
    {
      "name": "data_validator",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 60 },
      "scopes": [],
      "policy": { "allow_pii": false }
    }
  ],
  "system_prompt": "You build and maintain ETL pipelines, ensure data quality, and handle PII appropriately. Always validate schemas and log data lineage.",
  "reasoning_overlays": ["Deterministic"],
  "autonomy": {
    "level": 2,
    "description": "act-with-approval for schema changes"
  },
  "guardrails": {
    "red_lines": ["drop tables", "modify production schemas", "export PII without authorization"],
    "escalation": {
      "triggers": ["schema_mismatch", "data_quality_failure", "pii_detected"],
      "to": "data-eng-lead"
    },
    "rollback": {
      "supported": true,
      "procedure": "rb-etl-rollback"
    }
  },
  "kpis": ["pipeline_success_rate", "data_quality_score", "latency"],
  "audit": {
    "logging": ["queries", "data_lineage", "pii_access", "transformations"],
    "retention_days": 365,
    "explainability": { "store_rationales": true }
  }
}
