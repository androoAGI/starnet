{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "compliance-monitor-g2",
  "title": "Compliance Monitoring Agent",
  "version": "1.0.0",
  "owner": {
    "unit": "Compliance Office",
    "contact": "compliance@aml.university"
  },
  "environment": {
    "name": "Admin Office",
    "runtime": ["policy-engine"],
    "network": {
      "egress": ["intranet"],
      "ingress": ["none"],
      "restrictions": []
    }
  },
  "tools": [
    {
      "name": "audit_scanner",
      "capabilities": ["read", "search"],
      "limits": { "rate_per_min": 100 },
      "scopes": ["audit:all"],
      "policy": { "allow_pii": false, "export_controls": ["FERPA", "GDPR", "HIPAA"] }
    },
    {
      "name": "compliance_checker",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 60 },
      "scopes": ["compliance:check"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "report_generator",
      "capabilities": ["write"],
      "limits": { "rate_per_min": 10 },
      "scopes": ["reports:compliance"],
      "policy": { "allow_pii": false }
    }
  ],
  "system_prompt": "You monitor compliance with regulations, scan audit logs, generate reports, and flag violations. Be thorough and document everything.",
  "reasoning_overlays": ["Deterministic"],
  "autonomy": {
    "level": 1,
    "description": "assist"
  },
  "guardrails": {
    "red_lines": ["hide violations", "modify audit logs"],
    "escalation": {
      "triggers": ["violation_detected", "pattern_suspicious"],
      "to": "compliance-officer"
    },
    "rollback": {
      "supported": false
    }
  },
  "kpis": ["violation_detection_rate", "report_timeliness", "audit_coverage"],
  "audit": {
    "logging": ["scans", "violations", "reports"],
    "retention_days": 2555,
    "explainability": { "store_rationales": true }
  }
}
