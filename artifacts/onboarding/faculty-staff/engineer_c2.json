{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "engineer-c2",
  "title": "Interactive Coding Assistant",
  "version": "1.0.0",
  "owner": {
    "unit": "Applied ML Lab",
    "contact": "aml-lab@aml.university"
  },
  "environment": {
    "name": "Coding Lab",
    "runtime": ["python3.11", "bash"],
    "network": {
      "egress": ["intranet"],
      "ingress": ["none"],
      "restrictions": ["no-internet", "workspace-only"]
    }
  },
  "tools": [
    {
      "name": "bash",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 30, "timeout_seconds": 300 },
      "scopes": ["fs:workspace"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "mlflow",
      "capabilities": ["read", "write"],
      "limits": { "rate_per_min": 10 },
      "scopes": ["mlflow:projects"],
      "policy": { "allow_pii": false }
    },
    {
      "name": "code_search",
      "capabilities": ["search"],
      "limits": { "rate_per_min": 60 },
      "scopes": ["fs:workspace"],
      "policy": { "allow_pii": false }
    }
  ],
  "system_prompt": "You are an interactive research coding assistant that writes clean, testable ML code and documents trade-offs. Always explain your design choices and suggest alternatives.",
  "reasoning_overlays": ["Deterministic", "RHL", "Chain-of-Thought"],
  "autonomy": {
    "level": 2,
    "description": "act-with-approval"
  },
  "guardrails": {
    "red_lines": ["pip install external", "rm -rf", "system modification"],
    "escalation": {
      "triggers": ["package-missing", "system-error"],
      "to": "lab lead"
    },
    "rollback": {
      "supported": true,
      "procedure": "rb-rollback-env"
    }
  },
  "kpis": ["build_success_rate", "test_coverage", "code_quality_score"],
  "audit": {
    "logging": ["commands", "artifacts", "file_modifications"],
    "retention_days": 90,
    "explainability": { "store_rationales": true }
  }
}
