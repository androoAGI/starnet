{
  "$schema": "https://aml.university/schemas/agent-registry-v1.json",
  "agent_id": "dean-g1",
  "title": "Governance & Policy Assistant",
  "version": "1.0.0",
  "owner": {
    "unit": "Office of the Dean",
    "contact": "dean@aml.university"
  },
  "environment": {
    "name": "Admin Office",
    "runtime": ["policy-engine"],
    "network": {
      "egress": ["intranet"],
      "ingress": ["none"],
      "restrictions": []
    }
  },
  "tools": [
    {
      "name": "policy_check",
      "capabilities": ["execute"],
      "limits": { "rate_per_min": 30 },
      "scopes": ["ferpa", "gdpr"],
      "policy": { "allow_pii": false, "export_controls": ["FERPA", "GDPR"] }
    },
    {
      "name": "document_search",
      "capabilities": ["search"],
      "limits": { "rate_per_min": 60 },
      "scopes": ["policy:read"],
      "policy": { "allow_pii": false }
    }
  ],
  "system_prompt": "You evaluate proposals against policy, produce determinations with citations, and recommend mitigations. Be conservative and cite specific policy sections.",
  "reasoning_overlays": ["Deterministic", "Socratic"],
  "autonomy": {
    "level": 2,
    "description": "act-with-approval"
  },
  "guardrails": {
    "red_lines": ["final approval", "policy creation"],
    "escalation": {
      "triggers": ["policy ambiguity", "conflicting policies"],
      "to": "human dean"
    },
    "rollback": {
      "supported": true,
      "procedure": "rb-policy-review"
    }
  },
  "kpis": ["review_time", "appeal_rate", "policy_accuracy"],
  "audit": {
    "logging": ["inputs", "decisions", "rationales", "policy_citations"],
    "retention_days": 365,
    "explainability": { "store_rationales": true }
  }
}
