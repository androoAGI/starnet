{
  "schema": "starnet.engine-floor/1",
  "note": "The ONE web-engine floor StarNet promises. On macOS the app window is the system WebKit, which updates only with Safari / macOS. Every mirror reads or equals this file: tauri.conf.json bundle.macOS.minimumSystemVersion (= macos), frontend/app/bootguard.js FLOOR and its floor probes (= the api features whose since is the floor), test/webkit-floor-syntax.test.js (syntax and api features newer than the floor), and the WebKit floor shim (scripts/qa/webkit-floor-boot.mjs deletes every api feature newer than the floor). stage-frontend-dist.mjs refuses to stage a drifted mirror; test/engine-floor.test.js holds them equal. Moving the floor is a decision for Andrew: change it here, then the mirrors the staging refusal names.",
  "safari": "15.4",
  "macos": "11.0",
  "macosWithFloor": "12.3",
  "features": [
    { "id": "object-hasown", "kind": "api", "since": "15.4", "path": "Object.hasOwn" },
    { "id": "array-at", "kind": "api", "since": "15.4", "path": "Array.prototype.at" },
    { "id": "structured-clone", "kind": "api", "since": "15.4", "path": "structuredClone" },
    { "id": "crypto-random-uuid", "kind": "api", "since": "15.4", "path": "Crypto.prototype.randomUUID" },
    { "id": "dialog-show-modal", "kind": "api", "since": "15.4", "path": "HTMLDialogElement.prototype.showModal" },

    { "id": "regex-lookbehind", "kind": "syntax", "since": "16.4", "pattern": "\\(\\?<[=!]" },
    { "id": "class-static-block", "kind": "syntax", "since": "16.4", "pattern": "\\bstatic\\s*\\{" },

    { "id": "abortsignal-timeout", "kind": "api", "since": "16.0", "path": "AbortSignal.timeout" },
    { "id": "array-to-sorted", "kind": "api", "since": "16.0", "path": "Array.prototype.toSorted" },
    { "id": "array-to-reversed", "kind": "api", "since": "16.0", "path": "Array.prototype.toReversed" },
    { "id": "array-to-spliced", "kind": "api", "since": "16.0", "path": "Array.prototype.toSpliced" },
    { "id": "array-with", "kind": "api", "since": "16.0", "path": "Array.prototype.with" },
    { "id": "array-from-async", "kind": "api", "since": "16.4", "path": "Array.fromAsync" },
    { "id": "string-is-well-formed", "kind": "api", "since": "16.4", "path": "String.prototype.isWellFormed" },
    { "id": "string-to-well-formed", "kind": "api", "since": "16.4", "path": "String.prototype.toWellFormed" },
    { "id": "offscreen-canvas", "kind": "api", "since": "16.4", "path": "OffscreenCanvas" },
    { "id": "wake-lock", "kind": "api", "since": "16.4", "path": "Navigator.prototype.wakeLock" },
    { "id": "compression-stream", "kind": "api", "since": "16.4", "path": "CompressionStream" },
    { "id": "decompression-stream", "kind": "api", "since": "16.4", "path": "DecompressionStream" },
    { "id": "url-can-parse", "kind": "api", "since": "17.0", "path": "URL.canParse" },
    { "id": "set-union", "kind": "api", "since": "17.0", "path": "Set.prototype.union" },
    { "id": "set-intersection", "kind": "api", "since": "17.0", "path": "Set.prototype.intersection" },
    { "id": "set-difference", "kind": "api", "since": "17.0", "path": "Set.prototype.difference" },
    { "id": "set-symmetric-difference", "kind": "api", "since": "17.0", "path": "Set.prototype.symmetricDifference" },
    { "id": "set-is-subset-of", "kind": "api", "since": "17.0", "path": "Set.prototype.isSubsetOf" },
    { "id": "set-is-superset-of", "kind": "api", "since": "17.0", "path": "Set.prototype.isSupersetOf" },
    { "id": "set-is-disjoint-from", "kind": "api", "since": "17.0", "path": "Set.prototype.isDisjointFrom" },
    { "id": "show-popover", "kind": "api", "since": "17.0", "path": "HTMLElement.prototype.showPopover" },
    { "id": "object-group-by", "kind": "api", "since": "17.4", "path": "Object.groupBy" },
    { "id": "map-group-by", "kind": "api", "since": "17.4", "path": "Map.groupBy" },
    { "id": "promise-with-resolvers", "kind": "api", "since": "17.4", "path": "Promise.withResolvers" },
    { "id": "abortsignal-any", "kind": "api", "since": "17.4", "path": "AbortSignal.any" },
    { "id": "check-visibility", "kind": "api", "since": "17.4", "path": "Element.prototype.checkVisibility" },
    { "id": "start-view-transition", "kind": "api", "since": "18.0", "path": "Document.prototype.startViewTransition" },
    { "id": "url-parse", "kind": "api", "since": "18.0", "path": "URL.parse" },
    { "id": "promise-try", "kind": "api", "since": "18.2", "path": "Promise.try" },
