{
  "about": "The station lifecycle contract, shared by the sidecar's one record module (sidecar/station-record.js, test/station-record.test.js) and the desktop shell's native door (src-tauri/src/fresh_start.rs, test/native-process-ownership/tests/station_contract.rs). nativeMarkers pins the .fresh-start.json markers the native ERASE and START FRESH write (field names, order and values) and the JS legacy mirror's shape; cases pins what read() derives and what every predicate answers for each lifecycle shape, and what ensure() leaves on disk. File specs in a case are relative to the case's parent folder ($PARENT; the workspace is $PARENT/workspaces and $ROOT is its canonical path): a string is written as raw bytes, {json} as pretty JSON, {native, set} as a canonical native marker with fields overridden. In expectations \"$NOW\" is the case clock (now), generationId \"minted\" means a fresh valid id that no file in the case holds, and \"kept\" means the id of the case's own record. autoImport maps a root (\"\" = no root) to autoImportBlock's reason, null when automatic recovery may import. Times are epoch ms.",
  "recordFile": ".station.json",
  "freshMarker": ".fresh-start.json",
  "quarantineDir": "workspace-quarantine",
  "lifecycleFiles": [".station.json", ".fresh-start.json"],
  "seal": [".migrated"],
  "carryOnFresh": {
    "about": "What START FRESH carries into the clean generation through both doors (fresh_start.rs CREDITS_LINK). The rule: a regular file of at most maxBytes holding a JSON object is carried; anything else stays in the set-aside generation (never deleted), the clean generation starts unlinked and the result says so. Both doors honour every row: the reset is never refused over the link (fresh_start.rs preserve_credits_link, station-record.js carryInto). station_contract.rs and test/start-fresh-generation.test.js read these rows.",
    "files": [".secrets/credits.json"],
    "maxBytes": 65536,
    "rows": [
      { "name": "a JSON object is carried into the clean generation", "kind": "file", "text": "{\"url\":\"https://credits.example\",\"accountId\":\"acct-7\",\"linkedAt\":7}", "verdict": "carry" },
      { "name": "a JSON object of exactly 64 KiB is carried", "kind": "file", "text": "{\"accountId\":\"acct-7\"}", "padTo": 65536, "verdict": "carry" },
      { "name": "no link: the clean generation starts unlinked", "kind": "absent", "verdict": "none" },
      { "name": "bytes that are not JSON stay with the set-aside generation", "kind": "file", "text": "{torn", "verdict": "leave-aside" },
      { "name": "JSON that is not an object stays aside", "kind": "file", "text": "[1,2]", "verdict": "leave-aside" },
      { "name": "a link over 64 KiB stays aside", "kind": "file", "text": "{\"accountId\":\"acct-7\"}", "padTo": 65537, "verdict": "leave-aside" },
      { "name": "a directory at the link's path stays aside", "kind": "dir", "verdict": "leave-aside" },
      { "name": "a symlink at the link's path stays aside", "kind": "symlink", "verdict": "leave-aside" }
    ]
  },
  "nativeMarkers": {
    "about": "fresh_start.rs FreshMarker as written by set_aside_for_erase (erase) and quarantine_and_prepare (startFresh) with nowMs and acknowledgedRoots below. $QUARANTINE is the set-aside generation the call returned. keys is the field order on disk; the JS legacy mirror (mirrorMarker) writes the same keys in the same order. chain is the shape cases 'native START FRESH after an ERASE...' are built from: an ERASE, then a native START FRESH of the erased generation.",
    "keys": ["version", "erased", "at", "acknowledgedRoots", "quarantine", "moved"],
    "nowMs": 1793400000000,
    "acknowledgedRoots": ["/starnet-fixture/legacy/workspaces", "/starnet-fixture/update-snapshots"],
    "erase": { "version": 1, "erased": true, "at": "1793400000000", "acknowledgedRoots": ["/starnet-fixture/legacy/workspaces", "/starnet-fixture/update-snapshots"], "quarantine": null, "moved": [] },
    "startFresh": { "version": 1, "erased": false, "at": "1793400000000", "acknowledgedRoots": ["/starnet-fixture/legacy/workspaces", "/starnet-fixture/update-snapshots"], "quarantine": "$QUARANTINE", "moved": [] },
    "chain": {
      "erase": { "nowMs": 1793400000000, "acknowledgedRoots": ["/starnet-fixture/legacy/workspaces", "/starnet-fixture/update-snapshots"] },
      "startFresh": { "nowMs": 1793400060000, "acknowledgedRoots": ["/starnet-fixture/legacy/workspaces"] }
    }
  },
  "markerDialects": [
    { "dialect": "the native door: epoch ms as text", "at": "1793400000000", "ms": 1793400000000 },
    { "dialect": "the old sidecar door: ISO text", "at": "2026-10-16T01:33:45.763Z", "ms": 1792114425763 },
    { "dialect": "a number", "at": 1790000000000, "ms": 1790000000000 },
    { "dialect": "text that is not a time", "at": "soon", "ms": null },
    { "dialect": "empty text", "at": "", "ms": null },
    { "dialect": "null", "at": null, "ms": null },
    { "dialect": "a negative number", "at": -1, "ms": null },
    { "dialect": "a decimal V8's lenient Date.parse would read as a date", "at": "12.5", "ms": null },
    { "dialect": "a date that is not ISO", "at": "Sat Oct 31 2026", "ms": null },
    { "dialect": "exponent text", "at": "1e12", "ms": null }
  ],
  "markerShapes": [
    { "name": "the native ERASE marker", "native": "erase", "status": "ok" },
    { "name": "the native START FRESH marker", "native": "startFresh", "status": "ok" },
    { "name": "an old sidecar marker with no erased field", "marker": { "version": 1, "at": "2026-10-16T01:33:45.763Z", "acknowledgedRoots": [], "quarantine": null, "moved": [] }, "status": "ok" },
    { "name": "a marker with no at", "marker": { "version": 1, "acknowledgedRoots": [] }, "status": "torn" },
    { "name": "another version", "marker": { "version": 2, "at": "1793400000000", "acknowledgedRoots": [] }, "status": "torn" },
    { "name": "roots that are not a list", "marker": { "version": 1, "at": "1793400000000", "acknowledgedRoots": "/starnet-fixture/legacy/workspaces" }, "status": "torn" },
    { "name": "an empty root", "marker": { "version": 1, "at": "1793400000000", "acknowledgedRoots": [""] }, "status": "torn" },
    { "name": "a root that is not text", "marker": { "version": 1, "at": "1793400000000", "acknowledgedRoots": [null] }, "status": "torn" },
    { "name": "erased that is not a boolean", "marker": { "version": 1, "erased": "true", "at": "1793400000000", "acknowledgedRoots": [] }, "status": "torn" },
    { "name": "a JSON array", "raw": "[]", "status": "torn" },
    { "name": "torn bytes", "raw": "{\"version\":1,\"acknow", "status": "torn" }
  ],
  "acknowledgesRule": [
    { "platform": "win32", "acknowledged": "C:\\Users\\A\\AppData\\Local\\StarNet\\workspaces", "root": "c:/users/a/appdata/local/starnet/workspaces", "same": true },
    { "platform": "win32", "acknowledged": "C:\\Users\\A\\AppData\\Local\\StarNet\\workspaces", "root": "C:\\Users\\A\\AppData\\Local\\StarNet\\workspaces-other", "same": false },
    { "platform": "linux", "acknowledged": "/home/a/.local/share/StarNet/workspaces", "root": "/home/a/.local/share/starnet/workspaces", "same": false },
    { "platform": "linux", "acknowledged": "/home/a/x/../.local/share/StarNet/workspaces", "root": "/home/a/.local/share/StarNet/workspaces", "same": true },
    { "platform": "darwin", "acknowledged": "/Users/a/Library/Application Support/ai.skynet.harness/workspaces", "root": "/Users/a/Library/Application Support/AI.SKYNET.HARNESS/workspaces", "same": false }
  ],
