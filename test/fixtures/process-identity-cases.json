{
  "about": "Shared fixtures for the PID-reuse rule. sidecar/process-identity.js judgeReuse and src-tauri/src/process_identity.rs judge_reuse must both return `verdict` for every case (test/process-identity.fixtures.test.js and the Rust unit test read this one file). stamp = what a claimant wrote into its owner claim; seen = what a probe of the PID's CURRENT process returned. Times are epoch ms. 60 000 = REUSE_SLACK_MS, 2 000 = REUSE_EXE_SLACK_MS, 7 200 000 = the CIM tolerance.",
  "judge": [
    { "name": "equal Linux start ticks are the same process", "stamp": { "startedAt": 1000, "startTicks": "123456" }, "seen": { "ok": true, "startTicks": "123456" }, "verdict": "same-process" },
    { "name": "different Linux start ticks are a reused PID", "stamp": { "startedAt": 1000, "startTicks": "123456" }, "seen": { "ok": true, "startTicks": "999999" }, "verdict": "reused" },
    { "name": "ticks win over any wall-clock reading", "stamp": { "startedAt": 1000, "startTicks": "5" }, "seen": { "ok": true, "startTicks": "5", "startedAt": 99999999 }, "verdict": "same-process" },
    { "name": "a probe that failed is unknown (busy)", "stamp": { "startedAt": 1000, "executable": "node.exe" }, "seen": { "ok": false, "reason": "access denied" }, "verdict": "unknown" },
    { "name": "no start time on the probe is unknown", "stamp": { "startedAt": 1000, "executable": "node.exe" }, "seen": { "ok": true, "executable": "node.exe" }, "verdict": "unknown" },
    { "name": "no start time on the stamp is unknown", "stamp": { "executable": "node.exe" }, "seen": { "ok": true, "startedAt": 5000, "executable": "node.exe" }, "verdict": "unknown" },
