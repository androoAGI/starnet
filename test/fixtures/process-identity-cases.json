    { "name": "same image born more than the slack after the stamp is reused", "stamp": { "startedAt": 1000000, "executable": "node.exe" }, "seen": { "ok": true, "startedAt": 1060001, "executable": "node.exe" }, "verdict": "reused" },
    { "name": "same image born exactly at the slack edge is not proof", "stamp": { "startedAt": 1000000, "executable": "node.exe" }, "seen": { "ok": true, "startedAt": 1060000, "executable": "node.exe" }, "verdict": "same-process" },
    { "name": "a holder born before its own stamp is the same process", "stamp": { "startedAt": 1000000, "executable": "node.exe" }, "seen": { "ok": true, "startedAt": 999000, "executable": "node.exe" }, "verdict": "same-process" },
    { "name": "another image born past the 2 s slack is reused", "stamp": { "startedAt": 1000000, "executable": "node.exe" }, "seen": { "ok": true, "startedAt": 1002001, "executable": "cmd.exe" }, "verdict": "reused" },
    { "name": "another image inside the 2 s slack is not proof", "stamp": { "startedAt": 1000000, "executable": "node.exe" }, "seen": { "ok": true, "startedAt": 1002000, "executable": "cmd.exe" }, "verdict": "same-process" },
    { "name": "image names compare without directory, case or .exe", "stamp": { "startedAt": 1000000, "executable": "C:\\Program Files\\StarNet\\NODE.EXE" }, "seen": { "ok": true, "startedAt": 1030000, "executable": "/usr/local/bin/node" }, "verdict": "same-process" },
    { "name": "a missing image on either side never counts as another image", "stamp": { "startedAt": 1000000 }, "seen": { "ok": true, "startedAt": 1030000, "executable": "cmd.exe" }, "verdict": "same-process" },
    { "name": "an approximate (cim) reading proves reuse only past slack + tolerance", "stamp": { "startedAt": 1000000, "executable": "svchost.exe" }, "seen": { "ok": true, "startedAt": 8260001, "executable": "svchost.exe", "source": "cim", "toleranceMs": 7200000 }, "verdict": "reused" },
    { "name": "an approximate reading inside slack + tolerance is not proof", "stamp": { "startedAt": 1000000, "executable": "svchost.exe" }, "seen": { "ok": true, "startedAt": 8260000, "executable": "svchost.exe", "source": "cim", "toleranceMs": 7200000 }, "verdict": "same-process" },
    { "name": "an approximate reading of another image after the stamp is reused", "stamp": { "startedAt": 10000000, "executable": "node.exe" }, "seen": { "ok": true, "startedAt": 3000000, "executable": "svchost.exe", "source": "cim", "toleranceMs": 7200000 }, "verdict": "reused" },
