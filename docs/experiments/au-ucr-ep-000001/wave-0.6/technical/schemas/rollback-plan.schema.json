{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:au-ucr:schema:rollback-plan:1.0.0",
  "title":"Proposed RollbackAuthorization and IF-20 plan",
  "description":"PROPOSED_NOT_ADOPTED. Requires two purpose-specific approvers over one payload.",
  "type":"object","additionalProperties":false,
  "required":["contract_status","schema_id","schema_version","object_kind","object_id","event_id","interface_id","candidate","prerequisites","coordinator_issuer","security_issuer","trigger_ref","affected_release_ref","run_id","source_state_ref","rollback_target_ref","compatibility_evidence_ref","side_effect_inventory_ref","environment","actions","maximum_effects","compensations","credential_rotation","irreversible_effects","abort_boundary","effective_from","effective_through","payload_digest","signatures","outcome","reason_codes","verification_result"],
  "properties":{
    "contract_status":{"$ref":"common.schema.json#/$defs/proposalStatus"},
    "schema_id":{"const":"urn:au-ucr:schema:rollback-plan:1.0.0"},
    "schema_version":{"const":"1.0.0"},
    "object_kind":{"const":"ROLLBACK_AUTHORIZATION"},
    "object_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "event_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "interface_id":{"const":"IF-20"},
    "candidate":{"$ref":"common.schema.json#/$defs/candidateBinding"},
    "prerequisites":{"$ref":"authority-object-base.schema.json#/$defs/typedPrerequisites"},
    "coordinator_issuer":{"allOf":[{"$ref":"authority-object-base.schema.json#/$defs/issuer"},{"properties":{"role":{"const":"COORDINATOR_ARCHITECT"}}}]},
    "security_issuer":{"allOf":[{"$ref":"authority-object-base.schema.json#/$defs/issuer"},{"properties":{"role":{"const":"SECURITY_GOVERNANCE"}}}]},
    "trigger_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "affected_release_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "run_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "source_state_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "rollback_target_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "compatibility_evidence_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "side_effect_inventory_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "environment":{"$ref":"common.schema.json#/$defs/id"},
    "actions":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "maximum_effects":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "compensations":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "credential_rotation":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "irreversible_effects":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "abort_boundary":{"type":"string","minLength":1,"maxLength":1024},
    "effective_from":{"$ref":"common.schema.json#/$defs/timestamp"},
    "effective_through":{"$ref":"common.schema.json#/$defs/timestamp"},
    "payload_digest":{"$ref":"common.schema.json#/$defs/sha256"},
    "signatures":{"type":"array","minItems":2,"maxItems":2,"items":{"allOf":[{"$ref":"common.schema.json#/$defs/signature"},{"properties":{"key_purpose_id":{"const":"KP-ROLLBACK-AUTHORIZATION-v1"}}}]}},
    "outcome":{"enum":["ROLLBACK_AUTHORIZED","ROLLBACK_DENIED"]},
    "reason_codes":{"$ref":"common.schema.json#/$defs/reasonCodes"},
    "verification_result":{"$ref":"common.schema.json#/$defs/consumerResult"}
  }
}
