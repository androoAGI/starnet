{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:au-ucr:schema:nested-candidate-manifest:1.0.0",
  "title":"Proposed L0-L4 nested candidate manifest",
  "description":"PROPOSED_NOT_ADOPTED. Schema-side F04-NMF-05 hierarchy; no manifest instance or publication exists.",
  "type":"object","additionalProperties":false,
  "required":["contract_status","schema_id","schema_version","manifest_id","manifest_level","manifest_type","semantic_version","candidate_sequence","lifecycle_state","repository_id","canonical_remote_uri","canonicalization_id","sorted_member_rule","collision_policy","children","entry_count","created_at","generator_id","generator_version","authority_ref","previous_version_digest","relations","unsupported_reference_register_ref"],
  "properties":{
    "contract_status":{"$ref":"common.schema.json#/$defs/proposalStatus"},
    "schema_id":{"const":"urn:au-ucr:schema:nested-candidate-manifest:1.0.0"},
    "schema_version":{"const":"1.0.0"},
    "manifest_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "manifest_level":{"enum":["L0","L1","L2","L3","L4"]},
    "manifest_type":{"enum":["ARTIFACT_IDENTITY","FAMILY","WAVE","REVIEWED_SOURCE_ROOT","DECISION_PACKAGE_ROOT"]},
    "semantic_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "candidate_sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "lifecycle_state":{"enum":["DRAFT","FROZEN","PUBLISHED_VERIFIED","PUBLICATION_FAILED_QUARANTINED","SUPERSEDED","REVOKED"]},
    "parent_manifest_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "repository_id":{"$ref":"common.schema.json#/$defs/id"},
    "canonical_remote_uri":{"type":"string","minLength":1,"maxLength":512},
    "canonicalization_id":{"const":"CANON-JCS-RFC8785-v1"},
    "sorted_member_rule":{"const":"ASCENDING_UTF8_REPOSITORY_RELATIVE_PATH_BYTES"},
    "collision_policy":{"const":"REJECT_DUPLICATE_PATH_ID_CASE_COLLISION_TRAVERSAL_ALIAS_CYCLE"},
    "children":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["child_level","child_type","child_id","child_version","canonical_byte_count","digest","candidate_sequence","lifecycle_state","relationship","required"],"properties":{"child_level":{"enum":["L0","L1","L2","L3","L4"]},"child_type":{"$ref":"common.schema.json#/$defs/id"},"child_id":{"$ref":"common.schema.json#/$defs/id"},"child_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"canonical_byte_count":{"type":"integer","minimum":0,"maximum":1073741824},"digest":{"$ref":"common.schema.json#/$defs/sha256"},"candidate_sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},"lifecycle_state":{"$ref":"common.schema.json#/$defs/id"},"content_commit":{"$ref":"common.schema.json#/$defs/gitSha1"},"content_tree":{"$ref":"common.schema.json#/$defs/gitSha1"},"relationship":{"enum":["contains","reviewed","evidence_for","amends","supersedes","revokes"]},"required":{"type":"boolean"},"publication_locator":{"type":"string","minLength":1,"maxLength":1024}}}},
    "entry_count":{"type":"integer","minimum":0,"maximum":10000},
    "content_commit":{"$ref":"common.schema.json#/$defs/gitSha1"},
    "root_tree":{"$ref":"common.schema.json#/$defs/gitSha1"},
    "manifest_commit":{"$ref":"common.schema.json#/$defs/gitSha1"},
    "created_at":{"$ref":"common.schema.json#/$defs/timestamp"},
    "generator_id":{"$ref":"common.schema.json#/$defs/id"},
    "generator_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "authority_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "previous_version_digest":{"$ref":"common.schema.json#/$defs/sha256"},
    "relations":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/digestRef"}},
    "unsupported_reference_register_ref":{"$ref":"common.schema.json#/$defs/digestRef"}
  }
}
