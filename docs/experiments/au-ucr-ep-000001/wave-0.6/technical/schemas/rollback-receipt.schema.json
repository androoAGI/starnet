{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:au-ucr:schema:rollback-receipt:1.0.0",
  "title":"Proposed IF-21 rollback receipt",
  "description":"PROPOSED_NOT_ADOPTED. Records authorized rollback as a new version/event/session.",
  "type":"object","additionalProperties":false,
  "required":["envelope","rollback_plan_ref","source_snapshot_ref","target_ref","prior_object_version","new_object_version","event_ref","outbox_ref","compensation_results","rotated_credentials","invalidated_receipts","invalidated_nonces","irreversible_effects","new_session_required","outcome","reason_codes","verification_result"],
  "properties":{
    "envelope":{"allOf":[{"$ref":"common.schema.json#/$defs/signedEnvelope"},{"properties":{"schema_id":{"const":"urn:au-ucr:schema:rollback-receipt:1.0.0"},"object_type":{"const":"ROLLBACK_RECEIPT"},"interface_id":{"const":"IF-21"},"producer_role":{"const":"G_PEP_RECOVERY_CONTROLLER"},"key_purpose_id":{"const":"KP-ROLLBACK-RECEIPT-v1"},"signature":{"properties":{"key_purpose_id":{"const":"KP-ROLLBACK-RECEIPT-v1"}}}}}]},
    "rollback_plan_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "source_snapshot_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "target_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "prior_object_version":{"type":"integer","minimum":0,"maximum":9007199254740990},
    "new_object_version":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "event_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "outbox_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "compensation_results":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "rotated_credentials":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "invalidated_receipts":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/digestRef"}},
    "invalidated_nonces":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/nonce256"}},
    "irreversible_effects":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "new_session_required":{"const":true},
    "outcome":{"enum":["ROLLED_BACK","ROLLBACK_FAILED"]},
    "reason_codes":{"$ref":"common.schema.json#/$defs/reasonCodes"},
    "verification_result":{"$ref":"common.schema.json#/$defs/consumerResult"}
  }
}
