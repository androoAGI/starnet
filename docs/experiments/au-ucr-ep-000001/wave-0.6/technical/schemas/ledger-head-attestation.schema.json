{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:au-ucr:schema:ledger-head-attestation:1.0.0",
  "title":"Proposed IF-17 ledger-head attestation",
  "description":"PROPOSED_NOT_ADOPTED. Separate from runtime/TMC evidence and replaces the deprecated vector profile after vector regeneration.",
  "type":"object","additionalProperties":false,
  "required":["envelope","ledger_id","sequence","head_hash","policy_digest","prior_checkpoint_ref","verified_at"],
  "properties":{
    "envelope":{"allOf":[{"$ref":"common.schema.json#/$defs/signedEnvelope"},{"properties":{"schema_id":{"const":"urn:au-ucr:schema:ledger-head-attestation:1.0.0"},"object_type":{"const":"LEDGER_HEAD_ATTESTATION"},"interface_id":{"const":"IF-17"},"algorithm_id":{"const":"ALG-SIG-ES256-v1"},"canonicalization_id":{"const":"CANON-JCS-RFC8785-v1"},"framing_id":{"const":"FRAME-LEN-DOMAIN-v1"},"signing_profile_id":{"const":"PROFILE-LEDGER-HEAD-SIGNING-v1"},"key_purpose_id":{"const":"KP-LEDGER-HEAD-ATTEST-v1"},"domain_id":{"const":"DOMAIN-LEDGER-HEAD-ATTEST-v1"},"signature":{"allOf":[{"$ref":"common.schema.json#/$defs/signature"},{"required":["signature_encoding_id"],"properties":{"algorithm_id":{"const":"ALG-SIG-ES256-v1"},"signature_encoding_id":{"const":"SIGENC-ES256-P1363-LOW-S-B64URL-v1"},"key_purpose_id":{"const":"KP-LEDGER-HEAD-ATTEST-v1"},"signature_value":{"$ref":"common.schema.json#/$defs/es256P1363LowSBase64urlSignatureValue"}}}]}},"required":["domain_id","signing_profile_id"]}]},
    "ledger_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "head_hash":{"$ref":"common.schema.json#/$defs/sha256"},
    "policy_digest":{"$ref":"common.schema.json#/$defs/sha256"},
    "prior_checkpoint_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "verified_at":{"$ref":"common.schema.json#/$defs/timestamp"}
  },
  "$defs":{
    "envelopeBinding":{
      "type":"object",
      "additionalProperties":false,
      "required":["contract_status","schema_id","schema_version","object_type","object_id","event_id","interface_id","producer_id","producer_role","producer_assignment_ref","algorithm_id","key_purpose_id","canonicalization_id","framing_id","signing_profile_id","domain_id","issued_at","not_before","expires_at","authority_counter","previous_event_digest","audience","environment","repository_id","candidate_commit","publication_manifest_digest","policy_digest","schema_bundle_digest","algorithm_registry_digest","dependency_registry_digest","reason_registry_digest","revocation_epoch","nonce"],
      "properties":{
        "contract_status":{"$ref":"common.schema.json#/$defs/proposalStatus"},
        "schema_id":{"const":"urn:au-ucr:schema:ledger-head-attestation:1.0.0"},
        "schema_version":{"const":"1.0.0"},
        "object_type":{"const":"LEDGER_HEAD_ATTESTATION"},
        "object_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
        "event_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
        "interface_id":{"const":"IF-17"},
        "producer_id":{"$ref":"common.schema.json#/$defs/id"},
        "producer_role":{"$ref":"common.schema.json#/$defs/id"},
        "producer_assignment_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
        "algorithm_id":{"const":"ALG-SIG-ES256-v1"},
        "key_purpose_id":{"const":"KP-LEDGER-HEAD-ATTEST-v1"},
        "canonicalization_id":{"const":"CANON-JCS-RFC8785-v1"},
        "framing_id":{"const":"FRAME-LEN-DOMAIN-v1"},
        "signing_profile_id":{"const":"PROFILE-LEDGER-HEAD-SIGNING-v1"},
        "domain_id":{"const":"DOMAIN-LEDGER-HEAD-ATTEST-v1"},
        "issued_at":{"$ref":"common.schema.json#/$defs/timestamp"},
        "not_before":{"$ref":"common.schema.json#/$defs/timestamp"},
        "expires_at":{"$ref":"common.schema.json#/$defs/timestamp"},
        "authority_counter":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "previous_event_digest":{"$ref":"common.schema.json#/$defs/sha256"},
        "audience":{"$ref":"common.schema.json#/$defs/id"},
        "environment":{"$ref":"common.schema.json#/$defs/id"},
        "repository_id":{"$ref":"common.schema.json#/$defs/id"},
        "candidate_commit":{"$ref":"common.schema.json#/$defs/gitSha1"},
        "publication_manifest_digest":{"$ref":"common.schema.json#/$defs/sha256"},
        "run_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
        "session_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
        "object_version":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "policy_digest":{"$ref":"common.schema.json#/$defs/sha256"},
        "schema_bundle_digest":{"$ref":"common.schema.json#/$defs/sha256"},
        "algorithm_registry_digest":{"$ref":"common.schema.json#/$defs/sha256"},
        "dependency_registry_digest":{"$ref":"common.schema.json#/$defs/sha256"},
        "reason_registry_digest":{"$ref":"common.schema.json#/$defs/sha256"},
        "revocation_epoch":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "nonce":{"$ref":"common.schema.json#/$defs/nonce256"},
        "challenge_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
        "extensions":{"$ref":"common.schema.json#/$defs/extensions"}
      }
    },
    "signingPayload":{
      "type":"object",
      "additionalProperties":false,
      "required":["envelope_binding","ledger_id","sequence","head_hash","policy_digest","prior_checkpoint_ref","verified_at"],
      "properties":{
        "envelope_binding":{"$ref":"#/$defs/envelopeBinding"},
        "ledger_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
        "sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "head_hash":{"$ref":"common.schema.json#/$defs/sha256"},
        "policy_digest":{"$ref":"common.schema.json#/$defs/sha256"},
        "prior_checkpoint_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
        "verified_at":{"$ref":"common.schema.json#/$defs/timestamp"}
      }
    },
    "verificationFailureReason":{
      "enum":["E_TRUNCATED_INPUT","E_FRAMING_AMBIGUOUS","E_SCHEMA","E_VERSION_UNSUPPORTED","E_UNKNOWN_REGISTRY","E_DOMAIN_MISMATCH","E_KEY_PURPOSE","E_HASH_MISMATCH","E_SIGNATURE","E_AUTHORITY_ABSENT","E_REVOKED","E_REVOCATION_UNAVAILABLE","E_EXPIRED","E_NOT_YET_VALID","E_SCOPE","E_REPLAY","E_STALE","E_INTEGRITY","E_ANCHOR"]
    }
  }
}
