{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:au-ucr:schema:candidate-qa-receipt:1.0.0",
  "title":"Proposed CandidateQAReceipt",
  "description":"PROPOSED_NOT_ADOPTED. Exact-candidate QA evidence; cannot accept or release.",
  "type":"object","additionalProperties":false,
  "required":["envelope","object_kind","issuer","timing","candidate","prerequisites","qa_plan_ref","checks_executed","checks_blocked","defects","limitations","evidence_refs","outcome","reason_codes","verification_result"],
  "properties":{
    "envelope":{"allOf":[{"$ref":"common.schema.json#/$defs/signedEnvelope"},{"properties":{"schema_id":{"const":"urn:au-ucr:schema:candidate-qa-receipt:1.0.0"},"object_type":{"const":"CANDIDATE_QA"},"interface_id":{"const":"IF-02"},"producer_role":{"const":"QA_EVIDENCE_AGENT"},"key_purpose_id":{"const":"KP-QA-RECEIPT-v1"},"signature":{"properties":{"key_purpose_id":{"const":"KP-QA-RECEIPT-v1"}}}}}]},
    "object_kind":{"const":"CANDIDATE_QA"},
    "issuer":{"allOf":[{"$ref":"authority-object-base.schema.json#/$defs/issuer"},{"properties":{"role":{"const":"QA_EVIDENCE_AGENT"}}}]},
    "timing":{"$ref":"authority-object-base.schema.json#/$defs/authorityTiming"},
    "candidate":{"$ref":"common.schema.json#/$defs/candidateBinding"},
    "prerequisites":{"$ref":"authority-object-base.schema.json#/$defs/typedPrerequisites"},
    "qa_plan_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "checks_executed":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "checks_blocked":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "defects":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "limitations":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "evidence_refs":{"$ref":"authority-object-base.schema.json#/$defs/typedPrerequisites"},
    "outcome":{"enum":["QA_PASS","QA_FAIL","QA_BLOCKED"]},
    "reason_codes":{"$ref":"common.schema.json#/$defs/reasonCodes"},
    "verification_result":{"$ref":"common.schema.json#/$defs/consumerResult"}
  }
}
