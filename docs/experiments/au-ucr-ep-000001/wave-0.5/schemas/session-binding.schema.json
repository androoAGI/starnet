{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:au-ucr:schema:session-binding:1.0.0",
  "title": "Proposed session binding tuple",
  "description": "PROPOSED_NOT_ADOPTED. Complete decision/session binding input for IF-11; not itself a verifier verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_status","schema_id","schema_version","repository_id","candidate_commit","publication_manifest_digest","a09_receipt_ref","execution_release_ref","run_id","arm_ref","challenge_ref","session_id","runtime_instance_id","device_id","boot_id","tmc_id","process_id","process_created_at","runtime_key_id","effective_configuration_digest","module_set_digest","model_digest","endpoint_tuple_digest","policy_digest","schema_bundle_digest","algorithm_registry_digest","dependency_registry_digest","reason_registry_digest","trust_store_digest","revocation_snapshot_ref","verifier_receipt_time","fresh_until"],
  "properties": {
    "contract_status": { "$ref": "common.schema.json#/$defs/proposalStatus" },
    "schema_id": { "const": "urn:au-ucr:schema:session-binding:1.0.0" },
    "schema_version": { "const": "1.0.0" },
    "repository_id": { "$ref": "common.schema.json#/$defs/id" },
    "candidate_commit": { "$ref": "common.schema.json#/$defs/gitSha1" },
    "publication_manifest_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "a09_receipt_ref": { "$ref": "common.schema.json#/$defs/digestRef" },
    "execution_release_ref": { "$ref": "common.schema.json#/$defs/digestRef" },
    "run_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "arm_ref": { "$ref": "common.schema.json#/$defs/digestRef" },
    "challenge_ref": { "$ref": "common.schema.json#/$defs/digestRef" },
    "session_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "runtime_instance_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "device_id": { "$ref": "common.schema.json#/$defs/id" },
    "boot_id": { "$ref": "common.schema.json#/$defs/id" },
    "tmc_id": { "$ref": "common.schema.json#/$defs/id" },
    "process_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "process_created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "runtime_key_id": { "$ref": "common.schema.json#/$defs/id" },
    "effective_configuration_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "module_set_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "model_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "endpoint_tuple_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "policy_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "schema_bundle_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "algorithm_registry_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "dependency_registry_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "reason_registry_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "trust_store_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "revocation_snapshot_ref": { "$ref": "common.schema.json#/$defs/digestRef" },
    "verifier_receipt_time": { "$ref": "common.schema.json#/$defs/timestamp" },
    "fresh_until": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
