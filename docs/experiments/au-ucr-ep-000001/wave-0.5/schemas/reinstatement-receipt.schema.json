{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:au-ucr:schema:reinstatement-receipt:1.0.0",
  "title":"Proposed ReinstatementAuthorization",
  "description":"PROPOSED_NOT_ADOPTED. IF-22 creates new versions/sessions only; no terminal object is reactivated.",
  "type":"object","additionalProperties":false,
  "required":["contract_status","schema_id","schema_version","object_kind","object_id","event_id","interface_id","candidate","cause_ref","corrected_evidence_refs","qa_receipt_ref","review_receipt_ref","new_execution_release_ref","new_run_id","new_session_id","issuers","effective_from","effective_through","counter","nonce","prior_state","next_state","outcome","reason_codes","signatures","verification_result"],
  "properties":{
    "contract_status":{"$ref":"common.schema.json#/$defs/proposalStatus"},
    "schema_id":{"const":"urn:au-ucr:schema:reinstatement-receipt:1.0.0"},
    "schema_version":{"const":"1.0.0"},
    "object_kind":{"const":"REINSTATEMENT_AUTHORIZATION"},
    "object_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "event_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "interface_id":{"const":"IF-22"},
    "candidate":{"$ref":"common.schema.json#/$defs/candidateBinding"},
    "cause_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "corrected_evidence_refs":{"$ref":"authority-object-base.schema.json#/$defs/typedPrerequisites"},
    "qa_receipt_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "review_receipt_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "new_a09_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "new_g3_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "new_execution_release_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "new_run_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "new_session_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "issuers":{"type":"array","minItems":3,"maxItems":4,"items":{"$ref":"authority-object-base.schema.json#/$defs/issuer"},"allOf":[{"contains":{"properties":{"role":{"const":"QA_EVIDENCE_AGENT"}},"required":["role"]},"minContains":1,"maxContains":1},{"contains":{"properties":{"role":{"const":"INDEPENDENT_REVIEWER"}},"required":["role"]},"minContains":1,"maxContains":1},{"contains":{"properties":{"role":{"const":"COORDINATOR_ARCHITECT"}},"required":["role"]},"minContains":1,"maxContains":1}]},
    "effective_from":{"$ref":"common.schema.json#/$defs/timestamp"},
    "effective_through":{"$ref":"common.schema.json#/$defs/timestamp"},
    "counter":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "nonce":{"$ref":"common.schema.json#/$defs/nonce256"},
    "prior_state":{"const":"SUSPENDED"},
    "next_state":{"const":"REINSTATED_NEW_VERSION"},
    "outcome":{"enum":["REINSTATED_NEW_VERSION","REINSTATEMENT_DENIED"]},
    "reason_codes":{"$ref":"common.schema.json#/$defs/reasonCodes"},
    "signatures":{"type":"array","minItems":3,"maxItems":4,"items":{"allOf":[{"$ref":"common.schema.json#/$defs/signature"},{"properties":{"key_purpose_id":{"const":"KP-REINSTATEMENT-AUTHORIZATION-v1"}}}]}},
    "verification_result":{"$ref":"common.schema.json#/$defs/consumerResult"}
  },
  "allOf":[{"if":{"anyOf":[{"required":["new_a09_ref"]},{"required":["new_g3_ref"]}]},"then":{"properties":{"issuers":{"contains":{"properties":{"role":{"const":"DECISION_CHAIR"}},"required":["role"]},"minContains":1,"maxContains":1}}}}]
}
