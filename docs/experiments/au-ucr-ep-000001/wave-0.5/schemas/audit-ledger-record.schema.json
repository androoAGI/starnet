{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:au-ucr:schema:governed-audit-event:1.0.0",
  "title": "Proposed governed audit event record_without_hash",
  "description": "PROPOSED_NOT_ADOPTED. Exact Registry Section 6 JSON projection. Domain, ledger_id, sequence, prev_hash and record_hash are external.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id","schema_version","event_id","actor_id","interface_id","interface_inventory_id","object_id","prior_object_version","new_object_version","requested_transition","from_status","to_status","decision","reason_codes","policy_digest","schema_bundle_digest","algorithm_registry_digest","dependency_registry_digest","reason_registry_digest","evidence_bundle_digest","workload_identity","transaction_outcome","idempotency_key","correlation_id","trusted_receipt_time"],
  "properties": {
    "schema_id": { "const": "urn:au-ucr:schema:governed-audit-event:1.0.0" },
    "schema_version": { "const": "1.0.0" },
    "event_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "actor_id": { "$ref": "common.schema.json#/$defs/id" },
    "interface_id": { "const": "IF-15" },
    "interface_inventory_id": { "$ref": "common.schema.json#/$defs/id" },
    "object_id": { "$ref": "common.schema.json#/$defs/id" },
    "prior_object_version": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
    "new_object_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "requested_transition": { "type": "string", "minLength": 3, "maxLength": 128 },
    "from_status": { "enum": ["NOT_STARTED","IN_PROGRESS","READY","PASSED","FAILED","HOLD","SUSPENDED","ROLLED_BACK","SUPERSEDED"] },
    "to_status": { "enum": ["IN_PROGRESS","READY","PASSED","FAILED","HOLD","SUSPENDED","ROLLED_BACK","SUPERSEDED"] },
    "decision": { "const": "ALLOW" },
    "reason_codes": { "type": "array", "maxItems": 0 },
    "policy_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "schema_bundle_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "algorithm_registry_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "dependency_registry_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "reason_registry_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "evidence_bundle_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "workload_identity": { "$ref": "common.schema.json#/$defs/id" },
    "transaction_outcome": { "const": "COMMITTED" },
    "idempotency_key": { "$ref": "common.schema.json#/$defs/id" },
    "correlation_id": { "$ref": "common.schema.json#/$defs/id" },
    "trusted_receipt_time": { "$ref": "common.schema.json#/$defs/timestamp" },
    "publication_manifest_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "a09_receipt_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "execution_release_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "run_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "session_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
