{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:au-ucr:schema:findings-closure-receipt:1.0.0",
  "title":"Proposed FindingsClosureReceipt",
  "description":"PROPOSED_NOT_ADOPTED. Typed findings/dependency disposition; cannot accept or release.",
  "type":"object","additionalProperties":false,
  "required":["envelope","object_kind","issuer","timing","candidate","prerequisites","qa_receipt_ref","review_receipt_ref","finding_registry_ref","dependency_registry_ref","dispositions","remaining_blockers","policy_adoption_refs","baseline_hold_disposition","outcome","reason_codes","verification_result"],
  "properties":{
    "envelope":{"allOf":[{"$ref":"common.schema.json#/$defs/signedEnvelope"},{"properties":{"schema_id":{"const":"urn:au-ucr:schema:findings-closure-receipt:1.0.0"},"object_type":{"const":"FINDINGS_CLOSURE"},"interface_id":{"const":"IF-02"},"producer_role":{"const":"FINDINGS_CLOSURE_AUTHORITY"},"key_purpose_id":{"const":"KP-FINDINGS-CLOSURE-v1"},"signature":{"properties":{"key_purpose_id":{"const":"KP-FINDINGS-CLOSURE-v1"}}}}}]},
    "object_kind":{"const":"FINDINGS_CLOSURE"},
    "issuer":{"allOf":[{"$ref":"authority-object-base.schema.json#/$defs/issuer"},{"properties":{"role":{"const":"FINDINGS_CLOSURE_AUTHORITY"}}}]},
    "timing":{"$ref":"authority-object-base.schema.json#/$defs/authorityTiming"},
    "candidate":{"$ref":"common.schema.json#/$defs/candidateBinding"},
    "prerequisites":{"$ref":"authority-object-base.schema.json#/$defs/typedPrerequisites"},
    "qa_receipt_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "review_receipt_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "finding_registry_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "dependency_registry_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "dispositions":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["finding_id","disposition","authority_basis_ref","evidence_refs"],"properties":{"finding_id":{"$ref":"common.schema.json#/$defs/id"},"disposition":{"enum":["CLOSED","WAIVED","ACCEPTED_RISK","OPEN","BLOCKED"]},"authority_basis_ref":{"$ref":"common.schema.json#/$defs/digestRef"},"evidence_refs":{"$ref":"authority-object-base.schema.json#/$defs/typedPrerequisites"}}}},
    "remaining_blockers":{"$ref":"authority-object-base.schema.json#/$defs/closedStrings"},
    "policy_adoption_refs":{"$ref":"authority-object-base.schema.json#/$defs/typedPrerequisites"},
    "baseline_hold_disposition":{"type":"string","minLength":1,"maxLength":4096},
    "outcome":{"enum":["CLOSED","OPEN","BLOCKED"]},
    "reason_codes":{"$ref":"common.schema.json#/$defs/reasonCodes"},
    "verification_result":{"$ref":"common.schema.json#/$defs/consumerResult"}
  }
}
