{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:au-ucr:schema:outbox-delivery:1.0.0",
  "title":"Proposed IF-16 outbox delivery acknowledgement",
  "description":"PROPOSED_NOT_ADOPTED. Acknowledges exact committed bytes; cannot create authoritative state.",
  "type":"object","additionalProperties":false,
  "required":["contract_status","schema_id","schema_version","interface_id","delivery_id","outbox_id","event_id","ledger_envelope_ref","committed_bytes_digest","record_hash","delivery_state","attempt_count","worm_ledger_id","worm_sequence","received_at","decision","reason_codes"],
  "properties":{
    "contract_status":{"$ref":"common.schema.json#/$defs/proposalStatus"},
    "schema_id":{"const":"urn:au-ucr:schema:outbox-delivery:1.0.0"},
    "schema_version":{"const":"1.0.0"},
    "interface_id":{"const":"IF-16"},
    "delivery_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "outbox_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "event_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "ledger_envelope_ref":{"$ref":"common.schema.json#/$defs/digestRef"},
    "committed_bytes_digest":{"$ref":"common.schema.json#/$defs/sha256"},
    "record_hash":{"$ref":"common.schema.json#/$defs/sha256"},
    "delivery_state":{"enum":["PENDING","DELIVERED"]},
    "attempt_count":{"type":"integer","minimum":1,"maximum":1000},
    "worm_ledger_id":{"$ref":"common.schema.json#/$defs/uuidUrn"},
    "worm_sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "received_at":{"$ref":"common.schema.json#/$defs/timestamp"},
    "decision":{"enum":["ALLOW","SUSPEND","BLOCK","NO_MUTATION"]},
    "reason_codes":{"$ref":"common.schema.json#/$defs/reasonCodes"}
  }
}
